{
    "name": "nexdeve/nexpush-laravel",
    "description": "Instant push notifications for Laravel — FCM integration, token management, broadcast. No VPS needed.",
    "type": "library",
    "version": "1.0.0",
    "keywords": ["laravel", "push-notification", "fcm", "firebase", "nexpush"],
    "homepage": "https://github.com/nexdeve/nexpush",
    "license": "Apache-2.0",
    "authors": [
        { "name": "NexDeve", "homepage": "https://nexdeve.com" }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "NexDeve\\NexPush\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["NexDeve\\NexPush\\NexPushServiceProvider"],
            "aliases": { "NexPush": "NexDeve\\NexPush\\Facades\\NexPush" }
        }
    }
}
